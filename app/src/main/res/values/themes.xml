<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.GeofenceAlertMini" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/dark_blue</item>
        <item name="colorPrimaryVariant">@color/dark_blue_light</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/dark_blue_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar + nav bar -->
        <item name="android:statusBarColor">@color/dark_blue</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/gray_bg</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/gray_bg</item>

        <!-- Default text colors -->
        <item name="android:textColorPrimary">@color/dark_blue</item>
        <item name="android:textColorSecondary">@color/gray_text</item>
    </style>

    <style name="Theme.GeofenceAlertMini" parent="Base.Theme.GeofenceAlertMini" />

    <!-- Button style used app-wide -->
    <style name="Widget.GeofenceAlertMini.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/dark_blue_light</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
</resources>